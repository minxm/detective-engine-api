# 硅基流动 AI
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# AI 模型
AI_CHAT_MODEL=THUDM/GLM-4-9B-0414
AI_CASE_MODEL=Qwen/Qwen3-8B
AI_EVALUATE_MODEL=THUDM/GLM-4-9B-0414
AI_IMAGE_MODEL=Kwai-Kolors/Kolors

# 数据库：memory | cloudbase | mongodb
DB_ADAPTER=cloudbase
DB_DATA_DIR=./data
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=detective

# CloudBase 认证
TCB_ENV_ID=
TCB_PUBLIC_ENV_ID=
TCB_REGION=ap-shanghai
TCB_SECRET_ID=
TCB_SECRET_KEY=
# 可选：云存储 bucket（形如 636c-xxx-1250000000），有助于从 key 重建 fileID
TCB_STORAGE_BUCKET=

# EdgeOne KV：memory | edgeone
KV_ADAPTER=memory
EO_SECRET_ID=
EO_SECRET_KEY=
EO_ZONE_ID=
KV_NAMESPACE=

# EdgeOne Blob：local | cloudbase | edgeone（SCF 生产推荐 cloudbase）
BLOB_ADAPTER=cloudbase
BLOB_PUBLIC_BASE_URL=http://localhost:8787/blobs
EO_BLOB_UPLOAD_URL=
EO_BLOB_UPLOAD_TOKEN=
