# 硅基流动 AI
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# AI 模型
AI_CHAT_MODEL=THUDM/GLM-4-9B-0414
AI_CASE_MODEL=Qwen/Qwen3-8B
AI_EVALUATE_MODEL=deepseek-ai/DeepSeek-R1-0528-Qwen3-8B
AI_IMAGE_MODEL=Kwai-Kolors/Kolors

# 数据库：memory | mongodb
DB_ADAPTER=memory
DB_DATA_DIR=./data
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=detective

# CloudBase 认证
TCB_ENV_ID=
TCB_PUBLIC_ENV_ID=
TCB_REGION=ap-shanghai
TCB_SECRET_ID=
TCB_SECRET_KEY=

# EdgeOne KV：memory | edgeone
KV_ADAPTER=memory
EO_SECRET_ID=
EO_SECRET_KEY=
EO_ZONE_ID=
KV_NAMESPACE=

# EdgeOne Blob：local | edgeone
BLOB_ADAPTER=local
BLOB_PUBLIC_BASE_URL=http://localhost:8787/blobs
EO_BLOB_UPLOAD_URL=
EO_BLOB_UPLOAD_TOKEN=

# 管理后台（可选：运维接口密钥，与用户 role 无关）
ADMIN_SECRET=
